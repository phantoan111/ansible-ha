[Unit]
Description=Sentinel redis
Documentation=https://redis.io/docs/
After=network.target
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-sentinel /etc/redis/sentinel.conf --supervised systemd --daemonize no
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=65535


NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/redis
ReadWriteDirectories=/etc/redis


[Install]
WantedBy=multi-user.target