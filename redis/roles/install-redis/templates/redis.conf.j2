bind 0.0.0.0
port {{ redis_port }}
protected-mode no

# Authentication
requirepass {{ redis_password }}
masterauth {{ redis_password }}

# Persistence
save 900 1
save 300 10
save 60 10000
appendonly yes
appendfsync everysec
dir /var/lib/redis

# Memory
maxmemory {{ redis_maxmemory | default('1gb') }}
maxmemory-policy allkeys-lru

# Logging
loglevel notice
logfile /var/log/redis/redis-server.log

# Performance
tcp-backlog 511
tcp-keepalive 300