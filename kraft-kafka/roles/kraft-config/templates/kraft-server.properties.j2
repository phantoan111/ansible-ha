node.id={{ kafka_controller_id }}

# This node acts as both controller and broker
process.roles=broker,controller

# Controller quorum voters (all controller nodes)
#controller.quorum.voters={% for host in groups['kafka_controllers'] %}{{ hostvars[host].kafka_controller_id }}@{{ hostvars[host].ansible_host }}:{{ kafka_controller_port }}{% if not loop.last %},{% endif %}{% endfor %}

# Define the controller bootstrap servers
# List all three controllers for high availability
#controller.quorum.bootstrap.servers=kafka-node-1:9093,kafka-node-2:9093,kafka-node-3:9093
controller.quorum.bootstrap.servers={% for host in groups['kafka_controllers'] %}{{ hostvars[host].ansible_host }}:{{ kafka_controller_port }}{% if not loop.last %},{% endif %}{% endfor %}


# Listeners
listeners=PLAINTEXT://:{{ kafka_port }},CONTROLLER://:{{ kafka_controller_port }}
listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,SSL:SSL,SASL_PLAINTEXT:SASL_PLAINTEXT,SASL_SSL:SASL_SSL
inter.broker.listener.name=PLAINTEXT

controller.listener.names=CONTROLLER
advertised.listeners=PLAINTEXT://{{ ansible_host }}:{{ kafka_port }},CONTROLLER://{{ ansible_host }}:{{ kafka_controller_port }}

# Log directories (Kafka uses "log" to mean data)
log.dirs={{ kafka_data_dir }}

num.partitions={{ kraft_num_partitions }}
default.replication.factor={{ kraft_default_replication_factor }}
min.insync.replicas={{ kraft_insync_replicas }}

num.recovery.threads.per.data.dir={{ kraft_num_recovery_threads_per_data_dir }}
replica.fetch.max.bytes={{ kraft_replica_fetch_max_bytes }}

#Internal Topic Settings

offsets.topic.replication.factor={{ kraft_offsets_topic_replication_factor }}
share.coordinator.state.topic.replication.factor={{ kraft_share_coordinator_state_topic_replication_factor }}
share.coordinator.state.topic.min.isr={{ kraft_share_coordinator_state_topic_min_isr }}
transaction.state.log.replication.factor={{ kraft_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kraft_transaction_state_log_min_isr }}



# Log retention
log.retention.hours={{ kraft_log_retention_hours }}
log.retention.bytes={{ kraft_log_retention_bytes }}
log.segment.bytes={{ kraft_log_segment_bytes }}
log.retention.check.interval.ms={{ kraft_log_retention_check_interval_ms }}
message.max.bytes={{ kraft_message_max_bytes }}
log.flush.interval.messages={{ kraft_log_flush_interval_messages }}




# Consumer group configuration
# Initial rebalance delay to allow consumers time to join
group.initial.rebalance.delay.ms={{ kraft_group_initial_rebalance_delay_ms }}


# Network threads
num.network.threads={{ kraft_num_network_threads }}
num.io.threads={{ kraft_num_io_threads }}
socket.send.buffer.bytes={{ kraft_socket_send_buffer_bytes }}
socket.receive.buffer.bytes={{ kraft_socket_receive_buffer_bytes }}
socket.request.max.bytes={{ kraft_socket_request_max_bytes }}

