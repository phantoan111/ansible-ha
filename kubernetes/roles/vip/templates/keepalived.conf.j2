global_defs {
    router_id LVS_DEVEL
}
vrrp_script check_apiserver {
  script "/etc/keepalived/check_apiserver.sh"
  interval 3
  weight -2
  fall 10
  rise 2
}

vrrp_instance VI_1 {
{% if inventory_hostname in groups['master_init'] %}
    state MASTER   
{% endif %}

{% if inventory_hostname in groups['master_join'] %}
    state BACKUP   
{% endif %}

    interface {{ vip_interface }}
    virtual_router_id {{ ROUTER_ID }}
    priority {{ keepalived_priority }}

    authentication {
        auth_type PASS
        auth_pass k8spass
    }
    virtual_ipaddress {
        {{ vip_master }}
    }
    track_script {
        check_apiserver
    }
}